{
  "info": {
    "name": "OAN Notification Service",
    "description": "Collection for the Vistaar/OAN Notification Service API (NestJS). Base URL is parameterized via the `base_url` variable — defaults to the production reverse-proxy path `/notification-api`. No authentication is currently required by any endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "f3b1f2a0-6e2e-4c1a-9b8e-2c3d4e5f6a7b"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://registry-vistaar.da.gov.in/notification-api",
      "description": "Production base path (nginx rewrites /notification-api/X -> /api/X). For local dev use http://localhost:3000/api"
    }
  ],
  "item": [
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get Nearest Notifications",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"visitor_id\": \"abc123def456ghi789jkl012mno345pq\",\n    \"lat\": 28.630571365356445,\n    \"lon\": 77.08985900878906,\n    \"lang\": \"en\",\n    \"seen_message_ids\": [\"a1b2c3d4-e5f6-4890-abcd-ef1234567890\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/notification",
              "host": ["{{base_url}}"],
              "path": ["notification"]
            },
            "description": "Returns notifications/advisories nearest to the given lat/lon in the requested language.\n\nBody fields:\n- visitor_id (string, optional, 20-64 chars) — FingerprintJS visitor id\n- lat (number, required, -90..90)\n- lon (number, required, -180..180)\n- lang (string, required, exactly 2 chars, e.g. en/hi/gu)\n- seen_message_ids (array of UUIDv4 strings, optional)\n\nNote: global ValidationPipe rejects unknown fields (whitelist + forbidNonWhitelisted), so extra keys cause a 400."
          },
          "response": [
            {
              "name": "200 - Success with results",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"visitor_id\": \"abc123def456ghi789jkl012mno345pq\",\n    \"lat\": 28.630571365356445,\n    \"lon\": 77.08985900878906,\n    \"lang\": \"en\"\n}"
                },
                "url": { "raw": "{{base_url}}/notification", "host": ["{{base_url}}"], "path": ["notification"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"recipient\": {\n    \"visitor_id\": \"abc123def456ghi789jkl012mno345pq\",\n    \"lang_code\": \"en\",\n    \"lat\": 28.630571365356445,\n    \"lon\": 77.08985900878906\n  },\n  \"count\": 1,\n  \"notifications\": [\n    {\n      \"notification_id\": \"a1b2c3d4-e5f6-4890-abcd-ef1234567890\",\n      \"type\": \"WEATHER_ADVISORY\",\n      \"priority\": \"HIGH\",\n      \"valid_from\": \"2026-06-01\",\n      \"valid_to\": \"2026-06-08\",\n      \"created_at\": \"2026-06-01T08:00:00.000Z\",\n      \"content\": {\n        \"title\": \"Weather Advisory - Jalsu\",\n        \"body\": \"Moderate rainfall expected over the next 5 days...\"\n      },\n      \"location\": {\n        \"subdistrict_name\": \"Jalsu\",\n        \"district_name\": \"Jaipur Urban\",\n        \"state_name\": \"Rajasthan\"\n      },\n      \"metadata\": {\n        \"source\": \"IITM\",\n        \"template\": \"2bin_v2_bv\",\n        \"unique_id_iitm\": \"101885057\"\n      }\n    }\n  ],\n  \"error\": null\n}"
            },
            {
              "name": "200 - No matching subdistrict",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n    \"lat\": 0,\n    \"lon\": 0,\n    \"lang\": \"en\"\n}" },
                "url": { "raw": "{{base_url}}/notification", "host": ["{{base_url}}"], "path": ["notification"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"recipient\": { \"visitor_id\": null, \"lang_code\": \"en\", \"lat\": 0, \"lon\": 0 },\n  \"count\": 0,\n  \"notifications\": [],\n  \"error\": null\n}"
            },
            {
              "name": "400 - Validation error",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n    \"lat\": \"not-a-number\",\n    \"lon\": 77.08,\n    \"lang\": \"english\"\n}" },
                "url": { "raw": "{{base_url}}/notification", "host": ["{{base_url}}"], "path": ["notification"] }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"statusCode\": 400,\n  \"message\": [\"lat must be a number\", \"lang must be exactly 2 characters\"],\n  \"error\": \"BadRequestException\",\n  \"path\": \"/api/notification\",\n  \"timestamp\": \"2026-06-08T00:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Upload Advisories (CSV/XLSX)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "CSV or XLSX file, max 10 MB. Required columns per row: unique_id_iitm, subdistrict_code (or subdist_code_dbf), subdistrict_name (optional), district_code (or dist_code_dbf), district_name (optional), state_code (or state_code_dbf), state_name (optional), lang_abb, forecast_message (optional), from_date (YYYY-MM-DD or D-M-YYYY), to_date (YYYY-MM-DD or D-M-YYYY)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/notification/upload",
              "host": ["{{base_url}}"],
              "path": ["notification", "upload"]
            },
            "description": "Bulk-uploads weather advisories from a CSV or XLSX file (multipart/form-data, field name `file`). Note: do NOT manually set the Content-Type header — Postman will set the correct multipart boundary automatically.\n\ntemplate_abbreviation is hard-coded server-side to '2bin_v2_bv' for every inserted row."
          },
          "response": [
            {
              "name": "200 - Upload success (with some skipped rows)",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "advisories_2026_06.csv" }] },
                "url": { "raw": "{{base_url}}/notification/upload", "host": ["{{base_url}}"], "path": ["notification", "upload"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"summary\": {\n    \"total\": 150,\n    \"inserted\": 148,\n    \"skipped\": 2,\n    \"errors\": [\n      \"Row 5: missing lang_abb\",\n      \"Row 12: invalid date format: \\\"31-13-2026\\\"\"\n    ]\n  },\n  \"error\": null\n}"
            },
            {
              "name": "200 - No valid rows",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "bad_advisories.csv" }] },
                "url": { "raw": "{{base_url}}/notification/upload", "host": ["{{base_url}}"], "path": ["notification", "upload"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"summary\": { \"total\": 150, \"inserted\": 0, \"skipped\": 150, \"errors\": [\"Row 1: missing unique_id_iitm\", \"...\"] },\n  \"error\": { \"code\": \"NO_VALID_ROWS\", \"message\": \"No valid rows to insert\" }\n}"
            },
            {
              "name": "400 - No file uploaded",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": { "mode": "formdata", "formdata": [] },
                "url": { "raw": "{{base_url}}/notification/upload", "host": ["{{base_url}}"], "path": ["notification", "upload"] }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"statusCode\": 400,\n  \"message\": \"No file uploaded\",\n  \"error\": \"BadRequestException\",\n  \"path\": \"/api/notification/upload\",\n  \"timestamp\": \"2026-06-08T00:00:00.000Z\"\n}"
            },
            {
              "name": "400 - Unsupported file type",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "advisories.pdf" }] },
                "url": { "raw": "{{base_url}}/notification/upload", "host": ["{{base_url}}"], "path": ["notification", "upload"] }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"statusCode\": 400,\n  \"message\": \"Unsupported file type. Upload a CSV or XLSX file.\",\n  \"error\": \"BadRequestException\",\n  \"path\": \"/api/notification/upload\",\n  \"timestamp\": \"2026-06-08T00:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Get All Advisories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/notification/all?lang=en&state_code=8&from_date=2026-06-01&to_date=2026-06-30&active_only=true&page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["notification", "all"],
              "query": [
                { "key": "lang", "value": "en", "description": "ISO language code, exactly 2 chars (e.g. en, hi, gu)" },
                { "key": "state_code", "value": "8", "description": "Integer state code" },
                { "key": "from_date", "value": "2026-06-01", "description": "YYYY-MM-DD; ignored when active_only=true" },
                { "key": "to_date", "value": "2026-06-30", "description": "YYYY-MM-DD; ignored when active_only=true" },
                { "key": "active_only", "value": "true", "description": "boolean string 'true'/'false'; when true, overrides date filters and returns only currently-active advisories" },
                { "key": "page", "value": "1", "description": "integer >= 1, default 1" },
                { "key": "limit", "value": "50", "description": "integer 0-20000, default 100; limit=0 disables pagination (returns up to 20000 rows)" }
              ]
            },
            "description": "Lists advisories with optional filters and pagination. All query params are optional. See GET_ALL_ADVISORY_API.md in the repo for further examples."
          },
          "response": [
            {
              "name": "200 - Paginated list",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/notification/all?lang=en&state_code=8&page=1&limit=50",
                  "host": ["{{base_url}}"],
                  "path": ["notification", "all"],
                  "query": [
                    { "key": "lang", "value": "en" },
                    { "key": "state_code", "value": "8" },
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "50" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"total\": 342,\n  \"page\": 1,\n  \"limit\": 50,\n  \"pages\": 7,\n  \"unpaginated\": false,\n  \"data\": [\n    {\n      \"message_id\": \"a1b2c3d4-e5f6-4890-abcd-ef1234567890\",\n      \"unique_id_iitm\": \"101885057\",\n      \"subdistrict_code\": 80453,\n      \"subdistrict_name\": \"Jalsu\",\n      \"district_code\": 804,\n      \"district_name\": \"Jaipur Urban\",\n      \"state_code\": 8,\n      \"state_name\": \"Rajasthan\",\n      \"lang\": \"en\",\n      \"forecast_message\": \"Moderate rainfall expected over the next 5 days...\",\n      \"template\": \"2bin_v2_bv\",\n      \"type\": \"WEATHER_ADVISORY\",\n      \"priority\": \"HIGH\",\n      \"valid_from\": \"2026-06-01\",\n      \"valid_to\": \"2026-06-08\",\n      \"created_at\": \"2026-06-01T08:00:00.000Z\",\n      \"is_active\": true,\n      \"lat\": 26.9174,\n      \"lon\": 75.8471\n    }\n  ],\n  \"error\": null\n}"
            },
            {
              "name": "200 - Unpaginated (limit=0)",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/notification/all?limit=0",
                  "host": ["{{base_url}}"],
                  "path": ["notification", "all"],
                  "query": [{ "key": "limit", "value": "0" }]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"total\": 342,\n  \"page\": null,\n  \"limit\": null,\n  \"pages\": null,\n  \"unpaginated\": true,\n  \"data\": [ /* up to 20000 rows */ ],\n  \"error\": null\n}"
            }
          ]
        },
        {
          "name": "Get Advisory Counts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/notification/counts",
              "host": ["{{base_url}}"],
              "path": ["notification", "counts"]
            },
            "description": "Returns aggregate counts of advisories (total, by type, by language, geographic coverage)."
          },
          "response": [
            {
              "name": "200 - Counts",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{base_url}}/notification/counts", "host": ["{{base_url}}"], "path": ["notification", "counts"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"total\": 342,\n    \"weather_advisory\": 290,\n    \"general\": 52,\n    \"states\": 12,\n    \"districts\": 87,\n    \"subdistricts\": 213,\n    \"by_language\": { \"en\": 150, \"hi\": 120, \"gu\": 72 }\n  },\n  \"error\": null\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check (full)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Full health check via @nestjs/terminus — checks DB, system memory (heap/RSS), and disk."
          },
          "response": [
            {
              "name": "200 - Healthy",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"ok\",\n  \"info\": {\n    \"database\": { \"status\": \"up\" },\n    \"memory_heap\": { \"status\": \"up\" },\n    \"memory_rss\": { \"status\": \"up\" },\n    \"storage\": { \"status\": \"up\" }\n  },\n  \"error\": {},\n  \"details\": {\n    \"database\": { \"status\": \"up\" },\n    \"memory_heap\": { \"status\": \"up\" },\n    \"memory_rss\": { \"status\": \"up\" },\n    \"storage\": { \"status\": \"up\" }\n  }\n}"
            }
          ]
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/live",
              "host": ["{{base_url}}"],
              "path": ["health", "live"]
            },
            "description": "Lightweight liveness probe — does not check the database."
          },
          "response": [
            {
              "name": "200 - Alive",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{base_url}}/health/live", "host": ["{{base_url}}"], "path": ["health", "live"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"ok\",\n  \"timestamp\": \"2026-06-08T00:00:00.000Z\",\n  \"uptime\": 12345\n}"
            }
          ]
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/ready",
              "host": ["{{base_url}}"],
              "path": ["health", "ready"]
            },
            "description": "Readiness probe — checks the database connection only."
          },
          "response": [
            {
              "name": "200 - Ready",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{base_url}}/health/ready", "host": ["{{base_url}}"], "path": ["health", "ready"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"ok\",\n  \"info\": { \"database\": { \"status\": \"up\" } },\n  \"error\": {},\n  \"details\": { \"database\": { \"status\": \"up\" } }\n}"
            }
          ]
        }
      ]
    },
