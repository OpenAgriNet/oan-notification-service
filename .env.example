# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Use 'host.docker.internal' when running inside Docker on Linux
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD='kenpath$1'
DB_DATABASE=oan_notification

# Logging
LOG_LEVEL=debug

# Notifications
# 0 = current subdistrict only; positive values are kilometers
NOTIFICATION_RADIUS_KM=0

# IMD agromet advisory (Location Resolver + imd_agromet DB)
IMD_AGROMET_ENABLED=true
RESOLVER_URL=http://127.0.0.1:8001
RESOLVER_CALLBACK_URL=http://127.0.0.1:8081/api/notification/resolver/on_resolve
RESOLVER_API_KEY=
RESOLVER_SUBSCRIBER_ID=bv-notification
IMD_DB_URL=postgresql://postgres:postgres@localhost:5434/imd_agromet
RESOLVER_WAIT_MS=5000
